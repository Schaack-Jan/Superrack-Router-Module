<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Microsoft.Windows.Devices.Midi2 is distributed via GitHub releases
         (github.com/microsoft/MIDI), not nuget.org. The build workflow (or you,
         locally) downloads the .nupkg into ./packages before restoring. -->
    <add key="local-midi-sdk" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
